flowchart TB
  A(["מורה פותח/ת את היום"]):::start --> T06["היום שלי · T06"]:::scr
  T06 --> N01["סימון נוכחות, כיתה ושיעור נבחרים אוטומטית · N01"]:::scr
  N01 --> D1{"התאריך תקין?"}
  D1 -- "עתידי" --> E1["אי אפשר לסמן בתאריך עתידי"]:::err
  D1 -- "יום חופשה ביומן" --> E2["הודעה: אין חובת נוכחות ביום זה"]:::err
  D1 -- "תקין" --> L["נטענת רשימת הכיתה"]:::sys
  L --> D2{"איך מסמנים?"}
  D2 -- "כולם נוכחים ואז חריגים" --> M["סימון נעדר או איחור לתלמידים בודדים"]:::sys
  D2 -- "תלמיד אחר תלמיד" --> M
  M --> AS["שמירה אוטומטית אחרי כל שינוי"]:::sys
  AS --> D3{"השמירה הצליחה?"}
  D3 -- "לא" --> E3["הודעה בולטת: לא נשמר. השינויים נשארים במסך ואפשר לנסות שוב"]:::err
  E3 --> AS
  D3 -- "כן" --> DONE["סיום ושמירה"]:::sys
  DONE --> R["בדיקת חוקי סף · N04"]:::sys
  R --> D4{"חריגה מהסף?"}
  D4 -- "לא" --> END(["הושלם"]):::ok
  D4 -- "כן" --> AL["נוצרת התראה, פעם אחת לכל מקרה"]:::sys
  AL --> LOG["הודעה להורים נרשמת ביומן (שליחה מדומה בגרסה 1)"]:::sys
  LOG --> DASH["התראה פתוחה בדשבורד · X03 ובמסך N04"]:::scr
  DASH --> D5{"הטיפול"}
  D5 -- "סוגרים התראה עם הערה" --> END
  REQ["בקשת איחור או יציאה מוקדמת · N05"]:::scr --> D6{"המנהל/ת מאשר/ת?"}
  D6 -- "אושר" --> ST["הסטטוס בנוכחות הופך למאושר"]:::sys
  D6 -- "נדחה, חובה הערה" --> RJ["הבקשה נדחית והמבקש מקבל הודעה"]:::cancel
  N01 -.-> REQ

